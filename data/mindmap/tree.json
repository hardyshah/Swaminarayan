ayan.faith/about/our-saints/mandal-tree","src":"bhuj","gu":"સંત મંડળ","id":"nnd.4.3"}],"id":"nnd.4"},{"en":"Kalupur online","url":"https://swaminarayan.in/","src":"kal","gu":"કાલુપુર ઓનલાઈન","kind":"media","kids":[{"en":"Daily darshan, Kalupur","url":"https://swaminarayan.in/daily-darshan/kalupur-ahmedabad","src":"kal","gu":"દૈનિક દર્શન","kind":"media","id":"nnd.5.0"},{"en":"Daily darshan worldwide","url":"https://swaminarayan.in/daily-darshan/daily-darshan-worldwide","src":"kal","kind":"media","id":"nnd.5.1"},{"en":"Events calendar","url":"https://swaminarayan.in/events/calendar","src":"kal","gu":"કાર્યક્રમ","kind":"media","id":"nnd.5.2"},{"en":"YouTube channel","url":"https://www.youtube.com/@swaminarayantemplekalupur","src":"kal","kind":"media","id":"nnd.5.3"},{"en":"Music player","url":"https://music.swaminarayan.in","src":"kal","gu":"કીર્તન","kind":"media","id":"nnd.5.4"},{"en":"Picture gallery","url":"https://swaminarayan.in/media-gallery/picture-gallery","src":"kal","kind":"media","id":"nnd.5.5"},{"en":"Facebook","url":"https://www.facebook.com/swaminarayantemplekalupur","src":"kal","kind":"media","id":"nnd.5.6"},{"en":"Instagram","url":"https://www.instagram.com/swaminarayantemplekalupur/","src":"kal","kind":"media","id":"nnd.5.7"},{"en":"WhatsApp channel","url":"https://whatsapp.com/channel/0029Va93VAb4SpkDfnWpdR3c","src":"kal","kind":"media","id":"nnd.5.8"},{"en":"SoundCloud","url":"https://soundcloud.com/swaminarayantemplekalupur","src":"kal","kind":"media","id":"nnd.5.9"},{"en":"Contact","url":"https://swaminarayan.in/contact-us","src":"kal","kind":"media","id":"nnd.5.10"}],"id":"nnd.5"},{"en":"Bhuj online","url":"https://www.swaminarayan.faith/","src":"bhuj","gu":"ભુજ ઓનલાઈન","kind":"media","kids":[{"en":"Daily darshan","url":"https://www.swaminarayan.faith/prayer-and-worship/daily-darshan","src":"bhuj","gu":"દૈનિક દર્શન","kind":"media","id":"nnd.6.0"},{"en":"Calendar, nirnay and eclipses","url":"https://www.swaminarayan.faith/news-and-events/calendar",