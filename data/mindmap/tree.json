{"built":"tools/mindmap_build.py","sources":{"kal":{"t":"Shree Swaminarayan Mandir Kalupur (NarNarayan Dev Gadi)","u":"https://swaminarayan.in/"},"bhuj":{"t":"Shree Swaminarayan Mandir Bhuj (NarNarayan Dev diocese)","u":"https://www.swaminarayan.faith/"},"vad":{"t":"Shree LaxmiNarayan Dev Gadi, Vadtal","u":"https://swaminarayanvadtalgadi.org/"},"vadm":{"t":"Vadtal Mandir","u":"http://www.vadtalmandir.org/"},"site":{"t":"This site","u":"./"},"eb":{"t":"Bhuj e-book collection","u":"https://www.swaminarayan.faith/scriptures/ebooks"}},"tree":{"en":"Swaminarayan Sampraday","url":"https://www.swaminarayan.faith/our-faith/about-swaminarayan-bhagwan","src":"bhuj","gu":"શ્રી સ્વામિનારાયણ સંપ્રદાય","note":"The sampraday as Bhagwan Swaminarayan himself established it: two gadis, NarNarayan Dev (Ahmedabad) and LaxmiNarayan Dev (Vadtal), each with an acharya, temples, saints and scriptures.","kind":"root","id":"root","kids":[{"en":"Bhagwan Swaminarayan","url":"https://www.swaminarayan.faith/our-faith/about-swaminarayan-bhagwan/his-life","src":"bhuj","gu":"ભગવાન શ્રી સ્વામિનારાયણ","note":"His life, from Chhapaiya to Gadhada.","id":"shriji","kids":[{"en":"His life","url":"https://www.swaminarayan.faith/our-faith/about-swaminarayan-bhagwan/his-life","src":"bhuj","gu":"જીવન ચરિત્ર","id":"shriji.0"},{"en":"Ghanshyam Charitra","url":"https://swaminarayan.in/our-sampraday/swaminarayan-faith/ghanshyam-charitra","src":"kal","gu":"ઘનશ્યામ ચરિત્ર","note":"Childhood in Chhapaiya and Ayodhya.","id":"shriji.1"},{"en":"Vanvicharan (Nilkanth Varni)","url":"https://swaminarayan.in/our-sampraday/swaminarayan-faith/vanvicharan","src":"kal","gu":"વનવિચરણ","note":"Seven years of pilgrimage across India as Nilkanth Varni.","id":"shriji.2"},{"en":"Swaminarayan Charitra","url":"https://swaminarayan.in/our-sampraday/swaminarayan-faith/swaminarayan-charitra","src":"kal","gu":"સ્વામિનારાયણ ચરિત્ર","id":"shriji.3"},{"en":"Guru: Ramanand Swami","url":"https://www.swaminarayan.faith/articles/nand-santos/ramanand-swami","src":"bhuj","gu":"ગુરુ રામાનંદ સ્વામી","note":"Ramanand Swami received Vaishnavi diksha from Ramanujacharya in a dream; Shreeji Maharaj is his disciple and successor (Guru Parampara page).","id":"shriji.4"},{"en":"Letter to Ramanand Swami","url":"https://www.swaminarayan.faith/articles/letter-to-ramanand-swami","src":"bhuj","gu":"રામાનંદ સ્વામીને પત્ર","id":"shriji.5"},{"en":"The five vows","url":"https://www.swaminarayan.faith/our-faith/the-five-vows","src":"bhuj","gu":"પાંચ વર્તમાન","id":"shriji.6"},{"en":"What we believe","url":"https://www.swaminarayan.faith/our-faith/what-we-believe","src":"bhuj","gu":"સિદ્ધાંત","id":"shriji.7"},{"en":"Chhapaiya, birthplace","url":"https://www.swaminarayan.faith/temples/chhapaiya-temple","src":"bhuj","gu":"છપૈયા","kind":"temple","id":"shriji.8"},{"en":"Vicharan map: every village he visited","url":"vicharan/","src":"site","gu":"વિચરણ નકશો","kind":"site","id":"shriji.9"},{"en":"Kaal Patrak: his life day by day","url":"kaal-patrak/","src":"site","gu":"કાળ પત્રક","kind":"site","id":"shriji.10"},{"en":"Logbook: all 273 Vachanamruts dated","url":"vachanamrut-concordance/timeline.html","src":"site","gu":"નોંધપોથી","kind":"site","id":"shriji.11"},{"en":"Murti 3D: Gopinathji, Ghanshyam, Harikrishna","url":"murti-3d/","src":"site","gu":"મૂર્તિ 3D","kind":"site","id":"shriji.12"}]},{"en":"The two gadis","url":"https://www.swaminarayan.faith/about/guru-parampara","src":"bhuj","gu":"બે ગાદી","note":"Established at Vadtal on Kartik sud 11, VS 1882 (21 November 1825). Shreeji Maharaj adopted his nephews Ayodhyaprasadji and Raghuveerji as acharyas; the Desh Vibhag no Lekh divides the two dioceses and sets how acharyas are appointed. Shikshapatri shlokas 3 and 123–134 give the acharyas' niyams.","id":"gadis","kids":[{"en":"Shree NarNarayan Dev Gadi","url":"https://swaminarayan.in/","src":"kal","gu":"શ્રી નરનારાયણ દેવ ગાદી","note":"Seat at Kalupur, Ahmedabad. Uttar Vibhag (northern diocese).","id":"nnd","kids":[{"en":"Kalupur mandi